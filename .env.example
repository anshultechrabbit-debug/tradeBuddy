# ------------------------------------------------------------------
# TradeBuddy MVP — environment configuration
# Development works with NO paid credentials:
#   BROKER_PROVIDER=mock
#   MARKET_DATA_PROVIDER=development
# ------------------------------------------------------------------

# App
APP_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tradingtest?schema=public"

# Providers — swap these when real APIs are purchased.
# The business layer only talks to BrokerProvider / MarketDataProvider /
# NotificationProvider, so no other code needs to change.
BROKER_PROVIDER=mock
MARKET_DATA_PROVIDER=development
# Market data mode for the development provider:
#   external  (default) — real data via nselib (primary), jugaad-data (fallback)
#              and indian-market-data/nse-archives (historical backfill),
#              cached in Postgres. Never synthetic. Falls back to cached data when offline.
#   synthetic — deterministic fake candles generated offline (for demos/tests without network).
MARKET_DATA_MODE=external
NOTIFICATION_PROVIDER=development

# How many top-priority universe symbols the radar scan / breadth cover.
# Full real NSE list is ~2500 symbols; keep this small enough that a scan
# with live quotes finishes quickly. NIFTY 50 constituents always come first.
MAX_SCAN_SYMBOLS=150

# Python interpreter used by the external market-data bridge (must have
# nselib, jugaad-data and indian-market-data installed).
PYTHON_BIN=python3.12
# External development market data (used when MARKET_DATA_MODE=external)
# Timeout per external call (ms), retries, and rate limit per minute.
MARKET_DATA_TIMEOUT_MS=30000
MARKET_DATA_RETRIES=1
MARKET_DATA_RATE_LIMIT_PER_MINUTE=30
# Quote cache TTL before a re-fetch is attempted (ms).
MARKET_DATA_CACHE_TTL_MS=3600000
# How old data may be before it is reported as stale (ms).
MARKET_DATA_STALE_AFTER_MS=86400000
# Live NSE quote cache TTL (ms) before the NSE live API (jugaad) is re-polled.
# 5000 = ~5s effective latency during market hours. Raise if NSE rate-limits you.
MARKET_DATA_LIVE_TTL_MS=5000

# Encryption — AES-256-GCM key. Must be a 64-character hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Zerodha (leave empty until real API access is purchased)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_REDIRECT_URI=

# Upstox (leave empty until real API access is purchased)
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# Licensed market-data provider (leave empty until subscription exists)
MARKET_DATA_LICENSE_KEY=

# LLM strategy router (optional; deterministic router is used when empty)
LLM_PROVIDER=
LLM_API_KEY=

# Email notifications (optional; development provider logs instead)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Push notifications (optional; development provider logs instead)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=