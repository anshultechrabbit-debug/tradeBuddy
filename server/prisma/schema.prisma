// TradeBuddy MVP — Prisma schema
// PostgreSQL. Models map to snake_case table names via @@map/@map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & identity
// ---------------------------------------------------------------------------

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     UserRole[]

  @@map("roles")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String    @map("password_hash")
  fullName           String    @default("") @map("full_name")
  phone              String?
  tokenVersion       Int       @default(0) @map("token_version")
  status             String    @default("ACTIVE")
  subscriptionStatus String    @default("free") @map("subscription_status")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  roles               UserRole[]
  brokerConnections   BrokerConnection[]
  brokerTokens        BrokerToken[]
  consents            ConsentLedger[]
  dataSubjectRequests DataSubjectRequest[]
  scanSignals         ScanSignal[]
  portfolioHoldings   PortfolioHolding[]
  portfolioPositions  PortfolioPosition[]
  portfolioSnapshots  PortfolioSnapshot[]
  watchlist           Watchlist?
  alerts              Alert[]
  alertEvents         AlertEvent[]
  notifications       Notification[]
  orders              Order[]
  tradeJournal        TradeJournal[]
  scannerPrefs        UserScannerPref?
  auditLogs           AuditLog[]
  radarOpportunities  RadarOpportunity[]

  @@map("users")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Broker connections & encrypted tokens
// ---------------------------------------------------------------------------

model BrokerConnection {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker      String
  status      String    @default("DISCONNECTED")
  displayName String?   @map("display_name")
  lastSyncAt  DateTime? @map("last_sync_at")
  lastError   String?   @map("last_error")
  expiryAt    DateTime? @map("expiry_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  tokens      BrokerToken[]

  @@unique([userId, broker])
  @@index([status])
  @@map("broker_connections")
}

model BrokerToken {
  id             Int       @id @default(autoincrement())
  connectionId   Int       @map("connection_id")
  connection     BrokerConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId         Int       @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenType      String    @map("token_type")
  encryptedToken String    @map("encrypted_token")
  iv             String
  authTag        String    @map("auth_tag")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")

  @@unique([connectionId, tokenType])
  @@map("broker_tokens")
}

// ---------------------------------------------------------------------------
// DPDP / consent
// ---------------------------------------------------------------------------

model ConsentLedger {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker          String
  scope           String
  purpose         String
  consentVersion  String    @map("consent_version")
  status          String    @default("ACTIVE")
  createdAt       DateTime  @default(now()) @map("created_at")
  revokedAt       DateTime? @map("revoked_at")

  @@unique([userId, broker, scope])
  @@index([status])
  @@map("consent_ledger")
}

model DataSubjectRequest {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             String
  status           String    @default("PENDING")
  notes            String?
  responsePayload  Json?     @map("response_payload")
  resolutionNotes  String?   @map("resolution_notes")
  submittedAt      DateTime  @default(now()) @map("submitted_at")
  resolvedAt       DateTime? @map("resolved_at")

  @@map("data_subject_requests")
}

// ---------------------------------------------------------------------------
// Instruments & scan universe
// ---------------------------------------------------------------------------

model Instrument {
  id               Int       @id @default(autoincrement())
  instrumentKey    String    @unique @map("instrument_key")
  symbol           String
  exchange         String
  instrumentType   String    @map("instrument_type")
  name             String?
  sector           String?
  basePrice        Decimal?  @map("base_price")
  segment          String?
  underlyingSymbol String?   @map("underlying_symbol")
  expiry           DateTime?
  strikePrice      Decimal?  @map("strike_price")
  lotSize          Int?      @map("lot_size")
  tickSize         Decimal?  @map("tick_size")
  isin             String?
  enabled          Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")

  scanUniverse     ScanUniverse?
  marketQuotes     MarketQuote[]
  marketCandles    MarketCandle[]
  scanSignals      ScanSignal[]
  radarOpportunities RadarOpportunity[]
  portfolioHoldings PortfolioHolding[]
  portfolioPositions PortfolioPosition[]
  watchlistItems   WatchlistItem[]

  @@index([symbol])
  @@index([instrumentType])
  @@index([sector])
  @@map("instruments")
}

model ScanUniverse {
  id              Int       @id @default(autoincrement())
  instrumentId    Int       @unique @map("instrument_id")
  instrument      Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol          String
  exchange        String
  instrumentType  String    @map("instrument_type")
  enabled         Boolean   @default(true)
  priority        Int       @default(100)
  excluded        Boolean   @default(false)
  exclusionReason String?   @map("exclusion_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@index([symbol])
  @@map("scan_universe")
}

// ---------------------------------------------------------------------------
// Market data
// ---------------------------------------------------------------------------

model MarketQuote {
  id           Int       @id @default(autoincrement())
  instrumentId Int       @map("instrument_id")
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol       String
  exchange     String
  lastPrice    Decimal   @map("last_price")
  open         Decimal?
  high         Decimal?
  low          Decimal?
  prevClose    Decimal?  @map("prev_close")
  change       Decimal?
  changePct    Decimal?  @map("change_pct")
  volume       BigInt?
  bid          Decimal?
  ask          Decimal?
  source       String
  provider     String
  sourceTimestamp DateTime? @map("source_timestamp")
  receivedAt   DateTime? @map("received_at")
  timestamp    DateTime  @default(now())

  @@index([symbol])
  @@index([timestamp])
  @@unique([instrumentId, timestamp])
  @@map("market_quotes")
}

model MarketCandle {
  id           Int       @id @default(autoincrement())
  instrumentId Int       @map("instrument_id")
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol       String
  exchange     String
  timeframe    String    @default("1d")
  ts           DateTime
  open         Decimal
  high         Decimal
  low          Decimal
  close        Decimal
  volume       BigInt    @default(0)
  source       String
  provider     String
  sourceTimestamp DateTime? @map("source_timestamp")
  receivedAt   DateTime? @map("received_at")

  @@unique([instrumentId, timeframe, ts])
  @@index([symbol, timeframe, ts])
  @@map("market_candles")
}

model MarketDataAudit {
  id               Int      @id @default(autoincrement())
  provider         String
  source           String
  operation        String
  instrumentCount  Int?     @map("instrument_count")
  status           String
  message          String?
  durationMs       Int?     @map("duration_ms")
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("market_data_audit")
}

// ---------------------------------------------------------------------------
// Radar
// ---------------------------------------------------------------------------

model ScanSignal {
  id              Int      @id @default(autoincrement())
  userId          Int?     @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId    Int?     @map("instrument_id")
  instrument      Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  symbol          String
  exchange        String
  timestamp       DateTime @default(now())
  signal          String
  regime          String
  convictionScore Int      @map("conviction_score")
  features        Json
  reason          String
  dataSource      String   @map("data_source")

  @@index([userId, timestamp])
  @@index([symbol])
  @@map("scan_signals")
}

model RadarOpportunity {
  id              Int      @id @default(autoincrement())
  scanId          String   @map("scan_id")
  userId          Int?     @map("user_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrumentId    Int?     @map("instrument_id")
  instrument      Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  symbol          String
  exchange        String
  price           Decimal?
  signal          String
  regime          String
  convictionScore Int      @map("conviction_score")
  explanation     String
  dataSource      String   @map("data_source")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([scanId])
  @@index([createdAt])
  @@map("radar_opportunities")
}

// ---------------------------------------------------------------------------
// Portfolio
// ---------------------------------------------------------------------------

model PortfolioHolding {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker       String
  symbol       String
  exchange     String
  instrumentId Int?     @map("instrument_id")
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  quantity     Int
  averagePrice Decimal  @map("average_price")
  currentPrice Decimal? @map("current_price")
  costValue    Decimal? @map("cost_value")
  currentValue Decimal? @map("current_value")
  pnl          Decimal?
  pnlPct       Decimal? @map("pnl_pct")
  source       String   @default("broker")
  syncedAt     DateTime @default(now()) @map("synced_at")

  @@unique([userId, broker, symbol])
  @@map("portfolio_holdings")
}

model PortfolioPosition {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker       String
  symbol       String
  exchange     String
  instrumentId Int?     @map("instrument_id")
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  quantity     Int      @default(0)
  averagePrice Decimal? @map("average_price")
  lastPrice    Decimal? @map("last_price")
  dayQuantity  Int      @default(0) @map("day_quantity")
  dayAvgPrice  Decimal? @map("day_avg_price")
  pnl          Decimal?
  product      String   @default("CNC")
  syncedAt     DateTime @default(now()) @map("synced_at")

  @@unique([userId, broker, symbol])
  @@map("portfolio_positions")
}

model PortfolioSnapshot {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate  DateTime  @map("snapshot_date")
  investedValue Decimal?  @map("invested_value")
  currentValue  Decimal?  @map("current_value")
  totalPnl      Decimal?  @map("total_pnl")
  pnlPct        Decimal?  @map("pnl_pct")
  holdingsCount Int?      @map("holdings_count")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([userId, snapshotDate])
  @@map("portfolio_snapshots")
}

// ---------------------------------------------------------------------------
// Watchlist (one per user)
// ---------------------------------------------------------------------------

model Watchlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique @map("user_id")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String         @default("My Watchlist")
  createdAt DateTime       @default(now()) @map("created_at")
  items     WatchlistItem[]

  @@map("watchlists")
}

model WatchlistItem {
  id           Int        @id @default(autoincrement())
  watchlistId  Int        @map("watchlist_id")
  watchlist    Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrumentId Int?       @map("instrument_id")
  instrument   Instrument? @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  symbol       String
  exchange     String
  addedAt      DateTime   @default(now()) @map("added_at")

  @@unique([watchlistId, symbol, exchange])
  @@map("watchlist_items")
}

// ---------------------------------------------------------------------------
// Alerts & notifications
// ---------------------------------------------------------------------------

model Alert {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  symbol          String?
  alertType       String    @map("alert_type")
  threshold       Decimal
  active          Boolean   @default(true)
  channels        Json      @default("[\"in_app\"]")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  events          AlertEvent[]

  @@map("alerts")
}

model AlertEvent {
  id          Int       @id @default(autoincrement())
  alertId     Int       @map("alert_id")
  alert       Alert     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String?
  value       Decimal
  threshold   Decimal
  alertType   String    @map("alert_type")
  triggeredAt DateTime  @default(now()) @map("triggered_at")
  seen        Boolean   @default(false)

  @@map("alert_events")
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel     String    @default("in_app")
  provider    String
  title       String
  body        String
  metadata    Json?
  read        Boolean   @default(false)
  deliveredAt DateTime  @default(now()) @map("delivered_at")

  @@index([userId, deliveredAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Orders & trade journal
// ---------------------------------------------------------------------------

model Order {
  id            Int          @id @default(autoincrement())
  userId        Int          @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker        String
  brokerOrderId String       @map("broker_order_id")
  symbol        String
  exchange      String
  side          String
  orderType     String       @default("MARKET") @map("order_type")
  product       String       @default("CNC")
  quantity      Int
  price         Decimal?
  averagePrice  Decimal?     @map("average_price")
  status        String
  filledQuantity Int?        @map("filled_quantity")
  timestamp     DateTime
  events        OrderEvent[]
  journal       TradeJournal[]

  @@unique([broker, brokerOrderId])
  @@index([userId, timestamp])
  @@map("orders")
}

model OrderEvent {
  id        Int       @id @default(autoincrement())
  orderId   Int       @map("order_id")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  message   String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("order_events")
}

model TradeJournal {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   Int?     @map("order_id")
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  symbol    String
  exchange  String
  side      String
  quantity  Int
  price     Decimal
  timestamp DateTime
  status    String
  pnl       Decimal?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([orderId])
  @@index([userId, timestamp])
  @@map("trade_journal")
}

// ---------------------------------------------------------------------------
// Settings & audit
// ---------------------------------------------------------------------------

model UserScannerPref {
  id                    Int      @id @default(autoincrement())
  userId                Int      @unique @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  riskProfile           String   @default("moderate") @map("risk_profile")
  universeVisibility    String   @default("default") @map("universe_visibility")
  notificationChannels  Json     @default("[\"in_app\"]") @map("notification_channels")
  quietHoursEnabled     Boolean  @default(false) @map("quiet_hours_enabled")
  quietHoursStart       String   @default("22:00") @map("quiet_hours_start")
  quietHoursEnd         String   @default("08:00") @map("quiet_hours_end")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("user_scanner_prefs")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor      String?
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@map("audit_logs")
}

model InfraLog {
  id        Int       @id @default(autoincrement())
  level     String    @default("info")
  component String
  message   String
  metadata  Json?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([component, createdAt])
  @@index([level])
  @@map("infra_logs")
}